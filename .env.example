# Для compose.yaml (режим за своим reverse proxy).

# Внешний адрес страницы ссылки. В Connect пользователь вводит только хост.
OVPN_BASE_URL=https://vpn.example.com/ovpn

# Порт на 127.0.0.1 хоста, куда смотрит прокси
OVPN_HOST_PORT=8080

# Откуда контейнер видит прокси (шлюз docker-сети)
OVPN_TRUSTED_PROXIES=172.16.0.0/12

# Готовый образ вместо локальной сборки
# OVPN_IMAGE=mikedigriz/ovpn-sender:latest
